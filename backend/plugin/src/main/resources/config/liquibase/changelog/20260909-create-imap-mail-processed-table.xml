<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <!--
      One row per mail that has already started a process. The primary key is the duplicate
      guard: concurrent claims from two nodes collide here rather than creating two cases.
    -->
    <changeSet id="1" author="Ritense">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="imap_mail_processed"/>
            </not>
        </preConditions>
        <createTable tableName="imap_mail_processed">
            <!-- "<plugin configuration id>|<message identity>"; see IncomingMailHandler.claimKey. -->
            <column name="mail_identity" type="VARCHAR(512)">
                <constraints nullable="false" primaryKey="true"/>
            </column>
            <column name="plugin_configuration_id" type="VARCHAR(256)">
                <constraints nullable="false"/>
            </column>
            <column name="processed_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <!-- Supports the retention job, which deletes by age across all configurations. -->
    <changeSet id="2" author="Ritense">
        <preConditions onFail="MARK_RAN">
            <not>
                <indexExists indexName="idx_imap_mail_processed_processed_at"/>
            </not>
        </preConditions>
        <createIndex tableName="imap_mail_processed" indexName="idx_imap_mail_processed_processed_at">
            <column name="processed_at"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
